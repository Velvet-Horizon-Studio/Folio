{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "../package.json",
  "identifier": "com.velvethorizon.folio",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1600,
        "height": 1240,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0a0a0a",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../build/icon.ico"
    ]
  }
}
